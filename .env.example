# Copy this file to .env and fill in the keys you have.
# A missing key is NOT fatal: models from that provider are skipped and the
# fallback chain moves on. Never commit .env.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# true on corporate networks that inspect HTTPS (error: "UnknownIssuer" /
# "CERTIFICATE_VERIFY_FAILED"). Trusts the OS certificate store; never disables verification.
USE_SYSTEM_CERTS=false

# Where local embedding/reranker models are downloaded (~1.5 GB). Defaults to
# data/models inside the project. Uncomment to use another drive:
# MODEL_CACHE_DIR=D:\ragnition\models

# Required: primary LLM
GROQ_API_KEY=
# Required: embeddings + fallback LLM + judge   (https://aistudio.google.com)
GEMINI_API_KEY=
# Recommended: primary reranker                  (https://jina.ai)
JINA_API_KEY=
# Recommended: fallback reranker (trial: ~1000 calls/month)
COHERE_API_KEY=
# Optional: last-resort ":free" LLMs
OPENROUTER_API_KEY=
